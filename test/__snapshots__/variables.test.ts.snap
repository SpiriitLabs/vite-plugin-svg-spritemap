	},
	'no-default': {
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='' stroke='' d='M2 2h20v20H2z'/%3e%3c/svg%3e",
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='___color___' stroke='___edge___' d='M2 2h20v20H2z'/%3e%3c/svg%3e",
		width: 24px,
		height: 24px
	},
	'plain': {
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='lime' d='M2 2h20v20H2z'/%3e%3c/svg%3e",
		width: 24px,
		height: 24px
	},
	'themable': {
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cg fill='white'%3e%3cpath d='M2 2h8v8H2z'/%3e%3cpath stroke='white' stroke-width='2' d='M14 14h8v8h-8z'/%3e%3c/g%3e%3c/svg%3e",
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cg fill='___color___'%3e%3cpath d='M2 2h8v8H2z'/%3e%3cpath stroke='___color___' stroke-width='___weight___' d='M14 14h8v8h-8z'/%3e%3c/g%3e%3c/svg%3e",
		width: 24px,
		height: 24px
	}
}

$sprites-variables = {
	'commas': {
		'shadow': "rgba(0,0,0,.5)"
	},
	'escape': {
		'color': "#f0f",
		'font': "serif"
	},
	'invalid-name': {
	},
	'mismatch': {
		'color': "#fff"
	},
	'multi': {
		'dash-a': "2",
		'dash-b': "4"
	},
	'no-default': {
		'color': "",
		'edge': ""
	},
	'plain': {
	},
	'themable': {
		'weight': "2",
		'color': "#fff"
	}
}

sprite($name, $include-size = false, $type = 'uri', $mode = 'background', $route = '/__spritemap', $variables = {})
	// nested definitions are lexically scoped: they stay out of the importer's scope
	$sprite-entities = ('&' '&amp;'), ('<' '&lt;')
	// \`\\\` sits after \`%\`, so the \`%\` it introduces is not encoded in turn. A raw \`\\\`
	// would open a css escape in the \`url("...")\` string the uri ends up inside
	$sprite-escapes = ("'" '&apos;'), ('"' '&quot;'), ('%' '%25'), ('\\' '%5c'), ('#' '%23'), ('&' '%26'), (';' '%3b'), ('>' '%3e'), ('(' '%28'), (')' '%29'), ('{' '%7b'), ('}' '%7d'), (',' '%2c'), ('+' '%2b'), ('$' '%24'), ('?' '%3f')

	sprite-replace($string, $search, $replacement)
		join($replacement, split($search, $string))

	sprite-escape($value, $entities = true)
		$string = '' + $value
		if $entities
			for $escape in $sprite-entities
				$string = sprite-replace($string, $escape[0], $escape[1])
		for $escape in $sprite-escapes
			$string = sprite-replace($string, $escape[0], $escape[1])
		$string

	$sprite = $sprites[$name]
	$url = false

	if $type == 'fragment'
		$url = $route + '#' + $sprites-prefix + $name + '-view'

		if length($variables) > 0
			warn('sprite(): $variables cannot be applied to the "fragment" type, ignored')
	else if $type == 'uri'
		$url = $sprite[uri]

		if length($variables) > 0
			$defaults = {}
			if type($sprites-variables) == 'object' and $sprites-variables[$name] != null
				$defaults = $sprites-variables[$name]

			if length($defaults) == 0
				warn('sprite(): "' + $name + '" does not declare any variable, $variables is ignored')
			else
				$url = $sprite['uri-template']
				$merged = {}
				merge($merged, $defaults)
				merge($merged, $variables)

				for $key, $value in $merged
					if $key in $defaults
						// case-insensitively, as css matches a function name
						if $key in $variables and match('(var|url)[(]', '' + $value, 'i')
							warn('sprite(): "' + $key + '" is set to "' + $value + '", a css reference cannot see the page from inside a data uri')
						$url = sprite-replace($url, '___' + $key + '___', sprite-escape($value, $key in $variables))
					else
						warn('sprite(): "' + $name + '" has no variable named "' + $key + '"')
	else
		error('sprite(): $type must be either "fragment" or "uri"')

	if $url
		{$mode}: url($url) center no-repeat

		if $include-size
			if $include-size == true
				{$mode}-size: $sprite[width] $sprite[height]
			else if $include-size == 'box'
				width: $sprite[width]
				height: $sprite[height]
"
`;
