exports[`variables generation > emits a template uri and a defaults map (less) 1`] = `
"/* Generated by vite-plugin-svg-spritemap */

@sprites-prefix: 'sprite-';
@sprites: {
	@commas: {
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='rgba(0%2c0%2c0%2c.5)' d='M2 2h20v20H2z'/%3e%3c/svg%3e";
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='___shadow___' d='M2 2h20v20H2z'/%3e%3c/svg%3e";
		width: 24px;
		height: 24px;
	};
	@escape: {
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3ctext x='2' y='12' fill='%23f0f' font-family='serif'%3ea%3c/text%3e%3c/svg%3e";
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3ctext x='2' y='12' fill='___color___' font-family='___font___'%3ea%3c/text%3e%3c/svg%3e";
		width: 24px;
		height: 24px;
	};
	@invalid-name: {
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='var(--1color%2c white)' d='M2 2h20v20H2z'/%3e%3c/svg%3e";
		width: 24px;
		height: 24px;
	};
	@mismatch: {
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='white' d='M2 2h8v8H2z'/%3e%3cpath fill='white' d='M14 14h8v8h-8z'/%3e%3c/svg%3e";
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='___color___' d='M2 2h8v8H2z'/%3e%3cpath fill='___color___' d='M14 14h8v8h-8z'/%3e%3c/svg%3e";
		width: 24px;
		height: 24px;
	};
	@multi: {
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath stroke='black' stroke-dasharray='2 4' d='M2 12h20'/%3e%3c/svg%3e";
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath stroke='black' stroke-dasharray='___dash-a___ ___dash-b___' d='M2 12h20'/%3e%3c/svg%3e";
		width: 24px;
		height: 24px;
	};
	@no-default: {
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='' stroke='' d='M2 2h20v20H2z'/%3e%3c/svg%3e";
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='___color___' stroke='___edge___' d='M2 2h20v20H2z'/%3e%3c/svg%3e";
		width: 24px;
		height: 24px;
	};
	@plain: {
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='lime' d='M2 2h20v20H2z'/%3e%3c/svg%3e";
		width: 24px;
		height: 24px;
	};
	@themable: {
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cg fill='white'%3e%3cpath d='M2 2h8v8H2z'/%3e%3cpath stroke='white' stroke-width='2' d='M14 14h8v8h-8z'/%3e%3c/g%3e%3c/svg%3e";
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cg fill='___color___'%3e%3cpath d='M2 2h8v8H2z'/%3e%3cpath stroke='___color___' stroke-width='___weight___' d='M14 14h8v8h-8z'/%3e%3c/g%3e%3c/svg%3e";
		width: 24px;
		height: 24px;
	};
}

@sprites-variables: {
	@commas: 1, 'shadow' "rgba(0,0,0,.5)";
	@escape: 2, 'color' "#f0f", 'font' "serif";
	@invalid-name: 0;
	@mismatch: 1, 'color' "#fff";
	@multi: 2, 'dash-a' "2", 'dash-b' "4";
	@no-default: 2, 'color' "", 'edge' "";
	@plain: 0;
	@themable: 2, 'weight' "2", 'color' "#fff";
}

.sprite-entities(@value; @entities) when (@entities) {
  @spritemap-entities: replace(replace(~'@{value}', '&', '&amp;', 'g'), '<', '&lt;', 'g');
}

.sprite-entities(@value; @entities) when not (@entities) {
  @spritemap-entities: ~'@{value}';
}

.sprite-pair(@uri; @key; @value; @entities) {
  .sprite-entities(@value; @entities);
  @spritemap-xml: replace(replace(~'@{spritemap-entities}', "'", '&apos;', 'g'), '"', '&quot;', 'g');
  @spritemap-escaped: replace(replace(replace(replace(replace(escape(@spritemap-xml), '&', '%26', 'g'), ',', '%2c', 'g'), '[+]', '%2b', 'g'), '[$]', '%24', 'g'), '[?]', '%3f', 'g');
  @spritemap-uri: replace(@uri, '___@{key}___', @spritemap-escaped, 'g');
}

.sprite-emit(@mode; @uri) {
  @{mode}: url(@uri) center no-repeat;
}

// The user's override for @key, or @fallback when they passed none. Less has no
// one-element list, so a lone \`'name' value\` pair is doubled to keep the scan
// uniform: both copies carry the same key, so either one matching is the same.
.sprite-value(@variables; @key; @fallback) when (length(extract(@variables, 1)) < 2) {
  .sprite-value-scan(@variables, @variables; @key; @fallback; 1; 2);
}

.sprite-value(@variables; @key; @fallback) when (length(extract(@variables, 1)) >= 2) {
  .sprite-value-scan(@variables; @key; @fallback; 1; length(@variables));
}

.sprite-value-scan(@pairs; @key; @fallback; @i; @to) when (@i > @to) {
  @spritemap-value: @fallback;
  @spritemap-overridden: false;
}

.sprite-value-scan(@pairs; @key; @fallback; @i; @to) when (@i <= @to) {
  .sprite-value-step(@pairs; @key; @fallback; @i; @to; extract(extract(@pairs, @i), 1));
}

.sprite-value-step(@pairs; @key; @fallback; @i; @to; @name) when (@name = @key) {
  .sprite-value-join(extract(@pairs, @i); 3; extract(extract(@pairs, @i), 2));
  @spritemap-value: @spritemap-joined;
  @spritemap-overridden: true;
}

.sprite-value-step(@pairs; @key; @fallback; @i; @to; @name) when not (@name = @key) {
  .sprite-value-scan(@pairs; @key; @fallback; @i + 1; @to);
}

.sprite-value-join(@pair; @i; @accumulator) when (@i > length(@pair)) {
  @spritemap-joined: @accumulator;
}

.sprite-value-join(@pair; @i; @accumulator) when (@i <= length(@pair)) {
  @spritemap-next: extract(@pair, @i);
  .sprite-value-join(@pair; @i + 1; ~'@{accumulator} @{spritemap-next}');
}

// Walk the defaults, which come ordered longest name first so a short token can
// never shadow a longer one, and take the user's override per name. Replaying
// the user list in its own order instead would break that ordering.
.sprite-subst(@mode; @uri; @variables; @defaults; @i; @to) when (@i > @to) {
  .sprite-emit(@mode; @uri);
}

.sprite-subst(@mode; @uri; @variables; @defaults; @i; @to) when (@i <= @to) {
  .sprite-value(@variables; extract(extract(@defaults, @i), 1); extract(extract(@defaults, @i), 2));
  .sprite-pair(@uri; extract(extract(@defaults, @i), 1); @spritemap-value; @spritemap-overridden);
  .sprite-subst(@mode; @spritemap-uri; @variables; @defaults; @i + 1; @to);
}

.sprite-apply(@mode; @uri; @sprite; @variables; @defaults) when (extract(@defaults, 1) = 0) {
  .sprite-emit(@mode; @uri);
}

.sprite-apply(@mode; @uri; @sprite; @variables; @defaults) when not (extract(@defaults, 1) = 0) {
  .sprite-subst(@mode; @sprite[uri-template]; @variables; @defaults; 2; extract(@defaults, 1) + 1);
}

.sprite-vars(@mode; @uri; @sprite; @name; @variables) when (@variables = false) {
  .sprite-emit(@mode; @uri);
}

.sprite-vars(@mode; @uri; @sprite; @name; @variables) when not (@variables = false) {
  .sprite-apply(@mode; @uri; @sprite; @variables; @sprites-variables[ @@name]);
}

.sprite(@name, @include-size: false, @type: 'uri', @route: '/__spritemap', @mode: background, @variables: false) {
  @sprite: @sprites[ @@name];

  @fragment: if(
    @type = 'fragment',
    '@{route}#@{sprites-prefix}@{name}-view',
    false
  );
  @uri: if(@type = 'uri', @sprite[uri], false);

  & when (isstring(@fragment)) {
    @{mode}: url(@fragment) center no-repeat;
  }
  & when (isstring(@uri)) {
    .sprite-vars(@mode; @uri; @sprite; @name; @variables);
  }

  & when (isstring(@fragment)), (isstring(@uri)) {
    & when (@include-size) {
      @{mode}-size: @sprite[width] @sprite[height];
    }
    & when (@include-size = 'box') {
      width: @sprite[width];
      height: @sprite[height];
    }
  }
}
"
`;

exports[`variables generation > emits a template uri and a defaults map (scss) 1`] = `
"/* Generated by vite-plugin-svg-spritemap */

$sprites-prefix: 'sprite-';
$sprites: (
	'commas': (
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='rgba(0%2c0%2c0%2c.5)' d='M2 2h20v20H2z'/%3e%3c/svg%3e",
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='___shadow___' d='M2 2h20v20H2z'/%3e%3c/svg%3e",
		width: 24px,
		height: 24px
	),
	'escape': (
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3ctext x='2' y='12' fill='%23f0f' font-family='serif'%3ea%3c/text%3e%3c/svg%3e",
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3ctext x='2' y='12' fill='___color___' font-family='___font___'%3ea%3c/text%3e%3c/svg%3e",
		width: 24px,
		height: 24px
	),
	'invalid-name': (
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='var(--1color%2c white)' d='M2 2h20v20H2z'/%3e%3c/svg%3e",
		width: 24px,
		height: 24px
	),
	'mismatch': (
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='white' d='M2 2h8v8H2z'/%3e%3cpath fill='white' d='M14 14h8v8h-8z'/%3e%3c/svg%3e",
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='___color___' d='M2 2h8v8H2z'/%3e%3cpath fill='___color___' d='M14 14h8v8h-8z'/%3e%3c/svg%3e",
		width: 24px,
		height: 24px
	),
	'multi': (
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath stroke='black' stroke-dasharray='2 4' d='M2 12h20'/%3e%3c/svg%3e",
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath stroke='black' stroke-dasharray='___dash-a___ ___dash-b___' d='M2 12h20'/%3e%3c/svg%3e",
		width: 24px,
		height: 24px
	),
	'no-default': (
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='' stroke='' d='M2 2h20v20H2z'/%3e%3c/svg%3e",
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='___color___' stroke='___edge___' d='M2 2h20v20H2z'/%3e%3c/svg%3e",
		width: 24px,
		height: 24px
	),
	'plain': (
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cpath fill='lime' d='M2 2h20v20H2z'/%3e%3c/svg%3e",
		width: 24px,
		height: 24px
	),
	'themable': (
		uri: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cg fill='white'%3e%3cpath d='M2 2h8v8H2z'/%3e%3cpath stroke='white' stroke-width='2' d='M14 14h8v8h-8z'/%3e%3c/g%3e%3c/svg%3e",
		uri-template: "data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'%3e%3cg fill='___color___'%3e%3cpath d='M2 2h8v8H2z'/%3e%3cpath stroke='___color___' stroke-width='___weight___' d='M14 14h8v8h-8z'/%3e%3c/g%3e%3c/svg%3e",
		width: 24px,
		height: 24px
	)
);

$sprites-variables: (
	'commas': (
		'shadow': "rgba(0,0,0,.5)"
	),
	'escape': (
		'color': "#f0f",
		'font': "serif"
	),
	'invalid-name': (
	),
	'mismatch': (
		'color': "#fff"
	),
	'multi': (
		'dash-a': "2",
		'dash-b': "4"
	),
	'no-default': (
		'color': "",
		'edge': ""
	),
	'plain': (
	),
	'themable': (
		'weight': "2",
		'color': "#fff"
	)
);

@use "sass:list";
@use "sass:map";
@use "sass:meta";
@use "sass:string";

// \`-\` prefixed members are private: \`@use\` never exposes them to a consumer
$-sprite-entities: (
  ('&', '&amp;'),
  ('<', '&lt;')
);

$-sprite-escapes: (
  ("'", '&apos;'),
  ('"', '&quot;'),
  ('%', '%25'),
  // after \`%\`, so the \`%\` this introduces is not encoded in turn. A raw \`\\\` would
  // open a css escape in the \`url("...")\` string the uri ends up inside
  ('\\\\', '%5c'),
  ('#', '%23'),
  ('&', '%26'),
  (';', '%3b'),
  ('>', '%3e'),
  ('(', '%28'),
  (')', '%29'),
  ('{', '%7b'),
  ('}', '%7d'),
  (',', '%2c'),
  ('+', '%2b'),
  ('$', '%24'),
  ('?', '%3f')
);

@function -sprite-replace($string, $search, $replacement) {
  $index: string.index($string, $search);
  $result: '';
  $rest: $string;

  @while $index {
    $result: $result + string.slice($rest, 1, $index - 1) + $replacement;
    $rest: string.slice($rest, $index + string.length($search));
    $index: string.index($rest, $search);
  }

  @return $result + $rest;
}

@function -sprite-escape($value, $entities: true) {
  $string: '#{$value}';

  @if $entities {
    @each $escape in $-sprite-entities {
      $string: -sprite-replace($string, list.nth($escape, 1), list.nth($escape, 2));
    }
  }

  @each $escape in $-sprite-escapes {
    $string: -sprite-replace($string, list.nth($escape, 1), list.nth($escape, 2));
  }

  @return $string;
}

// case-insensitively, as css matches a function name: an uppercase \`VAR(\` reaches
// the data uri exactly like a lowercase one
@function -sprite-references($value) {
  $string: string.to-lower-case('#{$value}');

  @return string.index($string, 'var(') or string.index($string, 'url(');
}

@mixin sprite(
  $name,
  $include-size: false,
  $type: 'uri',
  $mode: 'background',
  $route: '/__spritemap',
  $variables: ()
) {
  $sprite: map.get($sprites, $name);
  $url: false;

  @if $type == 'fragment' {
    $url: '#{$route}##{$sprites-prefix}#{$name}-view';

    @if list.length($variables) > 0 {
      @warn 'sprite(): $variables cannot be applied to the "fragment" type, ignored.';
    }
  } @else if $type == 'uri' {
    $url: map.get($sprite, uri);

    @if list.length($variables) > 0 {
      $defaults: ();
      @if meta.global-variable-exists('sprites-variables') {
        $defaults: map.get($sprites-variables, $name) or ();
      }

      @if list.length($defaults) == 0 {
        @warn 'sprite(): "#{$name}" does not declare any variable, $variables is ignored.';
      } @else {
        $url: map.get($sprite, uri-template);

        @each $key, $value in map.merge($defaults, $variables) {
          @if map.has-key($defaults, $key) {
            $overridden: map.has-key($variables, $key);

            @if $overridden and -sprite-references($value) {
              @warn 'sprite(): "#{$key}" is set to "#{$value}", a css reference cannot see the page from inside a data uri.';
            }

            $url: -sprite-replace($url, '___#{$key}___', -sprite-escape($value, $overridden));
          } @else {
            @warn 'sprite(): "#{$name}" has no variable named "#{$key}", available: #{map.keys($defaults)}.';
          }
        }
      }
    }
  } @else {
    @error 'sprite(): $type must be either "fragment" or "uri"';
  }

  @if $url {
    #{$mode}: url($url) center no-repeat;

    @if $include-size {
      @if $include-size == true {
        #{$mode}-size: map.get($sprite, width) map.get($sprite, height);
      } @else if $include-size == 'box' {
        width: map.get($sprite, width);
        height: map.get($sprite, height);
      }
    }
  }
}
"
`;

