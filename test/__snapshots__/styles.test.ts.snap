@function -sprite-replace($string, $search, $replacement) {
  $index: string.index($string, $search);
  $result: '';
  $rest: $string;

  @while $index {
    $result: $result + string.slice($rest, 1, $index - 1) + $replacement;
    $rest: string.slice($rest, $index + string.length($search));
    $index: string.index($rest, $search);
  }

  @return $result + $rest;
}

@function -sprite-escape($value, $entities: true) {
  $string: '#{$value}';

  @if $entities {
    @each $escape in $-sprite-entities {
      $string: -sprite-replace($string, list.nth($escape, 1), list.nth($escape, 2));
    }
  }

  @each $escape in $-sprite-escapes {
    $string: -sprite-replace($string, list.nth($escape, 1), list.nth($escape, 2));
  }

  @return $string;
}

@function -sprite-call($string, $name) {
  $rest: $string;
  $offset: 0;
  $index: string.index($rest, $name);

  @while $index {
    $at: $offset + $index;
    $before: '';

    @if $at > 1 {
      $before: string.slice($string, $at - 1, $at - 1);
    }

    @if $before == '' or not string.index('abcdefghijklmnopqrstuvwxyz0123456789_-', $before) {
      @return true;
    }

    $offset: $at;
    $rest: string.slice($rest, $index + 1);
    $index: string.index($rest, $name);
  }

  @return false;
}

@function -sprite-references($value) {
  $string: string.to-lower-case('#{$value}');

  @return -sprite-call($string, 'var(') or -sprite-call($string, 'url(');
}

@mixin sprite(
  $name,
  $include-size: false,
  $type: 'uri',
  $mode: 'background',
  $route: '/__spritemap',
  $variables: ()
) {
  $sprite: map.get($sprites, $name);
  $url: false;

  @if $type == 'fragment' {
    $url: '#{$route}##{$sprites-prefix}#{$name}-view';

    @if list.length($variables) > 0 {
      @warn 'sprite(): $variables cannot be applied to the "fragment" type, ignored.';
    }
  } @else if $type == 'uri' {
    $url: map.get($sprite, uri);

    @if list.length($variables) > 0 {
      $defaults: ();
      @if meta.global-variable-exists('sprites-variables') {
        $defaults: map.get($sprites-variables, $name) or ();
      }

      @if list.length($defaults) == 0 {
        @warn 'sprite(): "#{$name}" does not declare any variable, $variables is ignored.';
      } @else {
        $url: map.get($sprite, uri-template);

        @each $key, $value in map.merge($defaults, $variables) {
          @if map.has-key($defaults, $key) {
            $overridden: map.has-key($variables, $key);

            @if $overridden and -sprite-references($value) {
              @warn 'sprite(): "#{$key}" is set to "#{$value}", a css reference cannot see the page from inside a data uri.';
            }

            $url: -sprite-replace($url, '___#{$key}___', -sprite-escape($value, $overridden));
          } @else {
            @warn 'sprite(): "#{$name}" has no variable named "#{$key}", available: #{map.keys($defaults)}.';
          }
        }
      }
    }
  } @else {
    @error 'sprite(): $type must be either "fragment" or "uri"';
  }

  @if $url {
    #{$mode}: url($url) center no-repeat;

    @if $include-size {
      @if $include-size == true {
        #{$mode}-size: map.get($sprite, width) map.get($sprite, height);
      } @else if $include-size == 'box' {
        width: map.get($sprite, width);
        height: map.get($sprite, height);
      }
    }
  }
}
"
`;

