icon-sprite($name, $include-size = false, $type = 'uri', $mode = 'background', $route = '/__spritemap', $variables = {})
	$icon-sprite-entities = ('&' '&amp;'), ('<' '&lt;')
	$icon-sprite-escapes = ("'" '&apos;'), ('"' '&quot;'), ('%' '%25'), ('\\' '%5c'), ('#' '%23'), ('&' '%26'), (';' '%3b'), ('>' '%3e'), ('(' '%28'), (')' '%29'), ('{' '%7b'), ('}' '%7d'), (',' '%2c'), ('+' '%2b'), ('$' '%24'), ('?' '%3f')

	icon-sprite-replace($string, $search, $replacement)
		join($replacement, split($search, $string))

	icon-sprite-escape($value, $entities = true)
		$string = '' + $value
		if $entities
			for $escape in $icon-sprite-entities
				$string = icon-sprite-replace($string, $escape[0], $escape[1])
		for $escape in $icon-sprite-escapes
			$string = icon-sprite-replace($string, $escape[0], $escape[1])
		$string

	$sprite = $icons[$name]
	$url = false

	if $type == 'fragment'
		$url = $route + '#' + $icon-prefix + $name + '-view'

		if length($variables) > 0
			warn('icon-sprite(): $variables cannot be applied to the "fragment" type, ignored.')
	else if $type == 'uri'
		$url = $sprite[uri]

		if length($variables) > 0
			$defaults = {}
			if type($sprites-variables) == 'object' and $sprites-variables[$name] != null
				$defaults = $sprites-variables[$name]

			if length($defaults) == 0
				warn('icon-sprite(): "' + $name + '" does not declare any variable, $variables is ignored.')
			else
				$url = $sprite['uri-template']
				$merged = merge({}, $defaults, $variables)

				for $key, $value in $merged
					if $key in $defaults
						if $key in $variables and match('(^|[^\\w-])(var|url)[(]', '' + $value, 'i')
							warn('icon-sprite(): "' + $key + '" is set to "' + $value + '", a css reference cannot see the page from inside a data uri.')
						$url = icon-sprite-replace($url, '___' + $key + '___', icon-sprite-escape($value, $key in $variables))
					else
						warn('icon-sprite(): "' + $name + '" has no variable named "' + $key + '", available: ' + keys($defaults) + '.')
	else
		error('icon-sprite(): $type must be either "fragment" or "uri"')

	if $url
		{$mode}: url($url) center no-repeat

		if $include-size
			if $include-size == true
				{$mode}-size: $sprite[width] $sprite[height]
			else if $include-size == 'box'
				width: $sprite[width]
				height: $sprite[height]
"
`;

