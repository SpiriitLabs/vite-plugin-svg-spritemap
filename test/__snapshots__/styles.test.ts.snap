						$url = sprite-replace($url, '___' + $key + '___', sprite-escape($value, $key in $variables))
					else
						warn('sprite(): "' + $name + '" has no variable named "' + $key + '", available: ' + keys($defaults) + '.')
	else
		error('sprite(): $type must be either "fragment" or "uri"')

	if $url
		{$mode}: url($url) center no-repeat

		if $include-size
			if $include-size == true
				{$mode}-size: $sprite[width] $sprite[height]
			else if $include-size == 'box'
				width: $sprite[width]
				height: $sprite[height]
"
`;

