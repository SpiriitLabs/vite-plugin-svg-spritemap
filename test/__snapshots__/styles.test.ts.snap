@sprites-variables: {
	@no_viewbox: 0;
	@no_width_height: 0;
	@spiriit: 0;
	@vite: 0;
}

.icon-sprite-entities(@value; @entities) when (@entities) {
  @spritemap-entities: replace(replace(~'@{value}', '&', '&amp;', 'g'), '<', '&lt;', 'g');
}

.icon-sprite-entities(@value; @entities) when not (@entities) {
  @spritemap-entities: ~'@{value}';
}

.icon-sprite-pair(@uri; @key; @value; @entities) {
  .icon-sprite-entities(@value; @entities);
  @spritemap-xml: replace(replace(~'@{spritemap-entities}', "'", '&apos;', 'g'), '"', '&quot;', 'g');
  @spritemap-escaped: replace(replace(replace(replace(replace(escape(@spritemap-xml), '&', '%26', 'g'), ',', '%2c', 'g'), '[+]', '%2b', 'g'), '[$]', '%24', 'g'), '[?]', '%3f', 'g');
  @spritemap-uri: replace(@uri, '___@{key}___', @spritemap-escaped, 'g');
}

.icon-sprite-emit(@mode; @uri) {
  @{mode}: url(@uri) center no-repeat;
}

.icon-sprite-value(@variables; @key; @fallback) when (length(extract(@variables, 1)) < 2) {
  .icon-sprite-value-scan(@variables, @variables; @key; @fallback; 1; 2);
}

.icon-sprite-value(@variables; @key; @fallback) when (length(extract(@variables, 1)) >= 2) {
  .icon-sprite-value-scan(@variables; @key; @fallback; 1; length(@variables));
}

.icon-sprite-value-scan(@pairs; @key; @fallback; @i; @to) when (@i > @to) {
  @spritemap-value: @fallback;
  @spritemap-overridden: false;
}

.icon-sprite-value-scan(@pairs; @key; @fallback; @i; @to) when (@i <= @to) {
  .icon-sprite-value-step(@pairs; @key; @fallback; @i; @to; extract(extract(@pairs, @i), 1));
}

.icon-sprite-value-step(@pairs; @key; @fallback; @i; @to; @name) when (@name = @key) {
  .icon-sprite-value-join(extract(@pairs, @i); 3; extract(extract(@pairs, @i), 2));
  @spritemap-value: @spritemap-joined;
  @spritemap-overridden: true;
}

.icon-sprite-value-step(@pairs; @key; @fallback; @i; @to; @name) when not (@name = @key) {
  .icon-sprite-value-scan(@pairs; @key; @fallback; @i + 1; @to);
}

.icon-sprite-value-join(@pair; @i; @accumulator) when (@i > length(@pair)) {
  @spritemap-joined: @accumulator;
}

.icon-sprite-value-join(@pair; @i; @accumulator) when (@i <= length(@pair)) {
  @spritemap-next: extract(@pair, @i);
  .icon-sprite-value-join(@pair; @i + 1; ~'@{accumulator} @{spritemap-next}');
}

.icon-sprite-subst(@mode; @uri; @variables; @defaults; @i; @to) when (@i > @to) {
  .icon-sprite-emit(@mode; @uri);
}

.icon-sprite-subst(@mode; @uri; @variables; @defaults; @i; @to) when (@i <= @to) {
  .icon-sprite-value(@variables; extract(extract(@defaults, @i), 1); extract(extract(@defaults, @i), 2));
  .icon-sprite-pair(@uri; extract(extract(@defaults, @i), 1); @spritemap-value; @spritemap-overridden);
  .icon-sprite-subst(@mode; @spritemap-uri; @variables; @defaults; @i + 1; @to);
}

.icon-sprite-apply(@mode; @uri; @sprite; @variables; @defaults) when (extract(@defaults, 1) = 0) {
  .icon-sprite-emit(@mode; @uri);
}

.icon-sprite-apply(@mode; @uri; @sprite; @variables; @defaults) when not (extract(@defaults, 1) = 0) {
  .icon-sprite-subst(@mode; @sprite[uri-template]; @variables; @defaults; 2; extract(@defaults, 1) + 1);
}

.icon-sprite-vars(@mode; @uri; @sprite; @name; @variables) when (@variables = false) {
  .icon-sprite-emit(@mode; @uri);
}

.icon-sprite-vars(@mode; @uri; @sprite; @name; @variables) when not (@variables = false) {
  .icon-sprite-apply(@mode; @uri; @sprite; @variables; @sprites-variables[ @@name]);
}

.icon-sprite(@name, @include-size: false, @type: 'uri', @mode: background, @route: '/__spritemap', @variables: false) {
  @sprite: @icons[ @@name];
  @spritemap-property: e(@mode);
  @spritemap-type: e(@type);
  @spritemap-size: e(@include-size);

  @fragment: if(
    @spritemap-type = fragment,
    '@{route}#@{icon-prefix}@{name}-view',
    false
  );
  @uri: if(@spritemap-type = uri, @sprite[uri], false);

  & when (isstring(@fragment)) {
    @{spritemap-property}: url(@fragment) center no-repeat;
  }
  & when (isstring(@uri)) {
    .icon-sprite-vars(@spritemap-property; @uri; @sprite; @name; @variables);
  }

  & when (isstring(@fragment)), (isstring(@uri)) {
    & when (@spritemap-size = true) {
      @{spritemap-property}-size: @sprite[width] @sprite[height];
    }
    & when (@spritemap-size = box) {
      width: @sprite[width];
      height: @sprite[height];
    }
  }
}
"
`;

